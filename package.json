{
  "name": "skala-study-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check-content.mjs",
    "build": "node scripts/check-content.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:artifact": "npm run build && node scripts/artifact.mjs",
    "build:vercel": "VITE_MATERIALS_BASE=https://raw.githubusercontent.com/minjeoong/study-book/HEAD/public/ npm run build && rm -rf dist/materials"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "js-yaml": "^4.1.0",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
